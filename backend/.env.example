SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
SECURITY_PASSWORD_SALT=replace-with-another-random-secret-at-least-32-characters
DATABASE_URL=sqlite:///hospital.db
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!
FRONTEND_ORIGIN=http://localhost:5173

# Optional: Celery + Redis appointment reminders
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REMINDER_WINDOW_HOURS=24
REMINDER_CHECK_MINUTES=15
# Leave MAIL_SERVER empty to log reminders instead of sending email
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_FROM=carepoint@example.com
